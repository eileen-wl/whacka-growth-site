---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AppDetail from "../../components/AppDetail.astro";
import { getApps, type AppToolData } from "../../lib/sanity";

export async function getStaticPaths() {
  const apps = await getApps();
  return apps.map((app) => ({
    params: { slug: app.slug },
    props: { app },
  }));
}

interface Props {
  app: AppToolData;
}

const { app } = Astro.props;

const keywords = [app.seo?.primaryKeyword, ...(app.seo?.secondaryKeywords ?? [])].filter(
  (keyword): keyword is string => Boolean(keyword)
);
---

<BaseLayout
  title={app.seo?.title || `${app.name} — ${app.tagline} | Small Business Mini App Toolkit`}
  description={app.seo?.metaDescription || app.shortDescription}
  keywords={keywords}
>
  <AppDetail app={app} />
</BaseLayout>
