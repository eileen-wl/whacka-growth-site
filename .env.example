# Sanity project connection used by the Astro site (src/lib/sanity.ts).
# Get these from https://www.sanity.io/manage after creating a project.
PUBLIC_SANITY_PROJECT_ID=your_project_id
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2024-01-01

# Write token, only needed to run the seed script (scripts/seed.ts).
# Create one at https://www.sanity.io/manage -> API -> Tokens (Editor permission).
# Never expose this to the browser — it is not prefixed with PUBLIC_.
SANITY_API_TOKEN=
