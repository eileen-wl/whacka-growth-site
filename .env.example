# Sanity project connection used by the Astro site (src/lib/sanity.ts).
# Get these from https://www.sanity.io/manage after creating a project.
PUBLIC_SANITY_PROJECT_ID=your_project_id
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2024-01-01

# Write token, needed to run the seed script (scripts/seed.ts) and for
# `npm run growth:cms-write -- --write-draft` (growth/scripts/write-cms-draft.ts).
# Create one at https://www.sanity.io/manage -> API -> Tokens (Editor permission).
# Never expose this to the browser — it is not prefixed with PUBLIC_.
# Not required for `growth:cms-write -- --dry-run`, which makes no network request.
SANITY_API_TOKEN=

# PostHog (src/lib/posthog.ts). Optional — if either is unset, PostHog
# simply never initializes and the site works identically without it.
# Get these from https://us.posthog.com/project/settings (or your region).
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=

# Canonical production URL, used for astro.config.mjs's `site`, sitemap
# generation, canonical <link> tags, and robots.txt. Falls back to
# http://localhost:4321 when unset (see astro.config.mjs). Also reused by
# the Asset Generation Agent (growth/scripts/generate-assets.ts) as the
# public collection/campaign landing page URL that collection-level social
# content points to (see "Social content is collection-level, not one app"
# in growth/README.md) — no separate variable was introduced for this,
# since this single-campaign site's homepage already is the collection
# landing page. When unset, social destinationUrl is left null rather than
# fabricated.
PUBLIC_SITE_URL=https://whacka-growth-site.vercel.app

# Google Search Console HTML-tag verification (Settings -> Ownership
# verification -> HTML tag -> copy just the content="..." value). Optional —
# when empty, no verification meta tag is rendered.
PUBLIC_GOOGLE_SITE_VERIFICATION=

PUBLIC_GA_MEASUREMENT_ID=

# PostHog server-side query access
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_API_HOST=https://us.posthog.com

# GA4 server-side query access (growth/collectors/ga4.ts). Numeric GA4
# property ID only (Admin -> Property details), not the G-XXXXXXX
# measurement ID. Auth is via local Application Default Credentials
# (`gcloud auth application-default login`) — no key file needed, see
# growth/README.md.
GA4_PROPERTY_ID=

# Google Search Console server-side API access
GSC_SITE_URL=

# Growth Report Agent (growth/scripts/generate-growth-report.ts). Not
# required for --dry-run or --provider mock — only for a live Anthropic
# run. GROWTH_REPORT_MODEL is intentionally left blank: the model isn't
# confirmed yet, and this script never hardcodes a default. Note that
# having Claude Code installed/logged in does NOT provide ANTHROPIC_API_KEY
# to this application — see growth/README.md.
GROWTH_REPORT_LLM_PROVIDER=anthropic
GROWTH_REPORT_MODEL=
GROWTH_REPORT_MAX_TOKENS=6000
ANTHROPIC_API_KEY=

# Experiment Decision Agent (growth/scripts/generate-experiment-decision.ts).
# Not required for --dry-run or --provider mock. Provider/model resolve
# with a fallback: EXPERIMENT_DECISION_LLM_PROVIDER -> GROWTH_REPORT_LLM_PROVIDER,
# and EXPERIMENT_DECISION_MODEL -> GROWTH_REPORT_MODEL — leave these blank to
# reuse the Growth Report Agent's provider/model, or set them to use a
# different one for decisions specifically. Reuses ANTHROPIC_API_KEY above.
EXPERIMENT_DECISION_LLM_PROVIDER=
EXPERIMENT_DECISION_MODEL=
EXPERIMENT_DECISION_MAX_TOKENS=6000

# Signal Mining Agent (growth/scripts/run-signal-mining.ts). Not required for
# --dry-run or --provider mock. Provider/model resolve with a fallback:
# SIGNAL_MINING_LLM_PROVIDER -> GROWTH_REPORT_LLM_PROVIDER, and
# SIGNAL_MINING_MODEL -> GROWTH_REPORT_MODEL — leave these blank to reuse the
# Growth Report Agent's provider/model, or set them to use a different one for
# signal mining specifically. Reuses ANTHROPIC_API_KEY above.
SIGNAL_MINING_LLM_PROVIDER=
SIGNAL_MINING_MODEL=
SIGNAL_MINING_MAX_TOKENS=8000
SIGNAL_MINING_MAX_SOURCE_RECORDS=100

# Topic Scoring Agent (growth/scripts/run-topic-scoring.ts). Not required for
# --dry-run or --provider mock. Provider/model resolve with a fallback:
# TOPIC_SCORING_LLM_PROVIDER -> GROWTH_REPORT_LLM_PROVIDER, and
# TOPIC_SCORING_MODEL -> GROWTH_REPORT_MODEL — leave these blank to reuse the
# Growth Report Agent's provider/model, or set them to use a different one for
# topic scoring specifically. Reuses ANTHROPIC_API_KEY above.
# TOPIC_SCORING_PROFILE identifies the fixed v1 scoring rubric this Agent
# uses (growth/scoring/topic-scoring-profile.ts) — informational only, not
# read by the script (the profile is a fixed code constant, not configurable).
TOPIC_SCORING_LLM_PROVIDER=
TOPIC_SCORING_MODEL=
TOPIC_SCORING_MAX_TOKENS=12000
TOPIC_SCORING_PROFILE=small_business_topic_scoring@1.0.0

# Asset Generation Agent (growth/scripts/generate-assets.ts). Not required for
# --dry-run or --provider mock. Provider/model resolve with a fallback:
# ASSET_GENERATION_LLM_PROVIDER -> GROWTH_REPORT_LLM_PROVIDER, and
# ASSET_GENERATION_MODEL -> GROWTH_REPORT_MODEL — leave these blank to reuse
# the Growth Report Agent's provider/model, or set them to use a different one
# for asset generation specifically. Reuses ANTHROPIC_API_KEY above.
# ASSET_GENERATION_PROMPT_VERSION is part of the deterministic AssetBundle ID
# basis (growth/agents/asset-generation-agent.ts) — bump it if prompt changes
# should be treated as a new generation rather than overwriting the same
# bundle.
ASSET_GENERATION_LLM_PROVIDER=
ASSET_GENERATION_MODEL=
ASSET_GENERATION_MAX_TOKENS=10000
ASSET_GENERATION_PROMPT_VERSION=1.0.0